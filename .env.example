# VaporFlow Supabase Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env or service_role secrets into version control.
#
# Credentials can also be entered directly in the app (Settings -> Cloud
# Connection, or the first-run wizard's "Join an existing shop" tab); the
# in-app settings are what the app actually uses.
#
# Key format: classic anon keys look like "eyJ..." (JWT); newer projects
# issue "sb_publishable_..." keys. Both work — use the anon/publishable key,
# never the service_role secret.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
