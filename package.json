{
  "name": "vaporflow",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "dev:desktop": "pnpm --filter @vaporflow/desktop dev",
    "build:desktop": "pnpm --filter @vaporflow/desktop build",
    "android:run": "pnpm --filter @vaporflow/mobile android:run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  }
}
