{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@vaporflow/core": [
        "./packages/core/src/index.ts"
      ]
    }
  },
  "references": [
    {
      "path": "packages/core"
    },
    {
      "path": "apps/mobile"
    },
    {
      "path": "packages/app"
    },
    {
      "path": "apps/desktop"
    }
  ],
  "files": []
}
