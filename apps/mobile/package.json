{
  "name": "@vaporflow/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vaporflow/app build && node -e \"const fs=require('fs');fs.cpSync('../../packages/app/dist','./dist',{recursive:true,force:true})\"",
    "cap:sync": "npx cap sync android",
    "android:run": "pnpm build && npx cap sync android && npx cap run android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@vaporflow/app": "workspace:*"
  }
}
