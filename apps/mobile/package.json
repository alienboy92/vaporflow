{
  "name": "@vaporflow/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vaporflow/app exec vite build --outDir ../../apps/mobile/dist --emptyOutDir",
    "cap:sync": "npx cap sync android",
    "android:run": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/android.ps1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "6.0.2",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@vaporflow/capacitor-printer": "workspace:*",
    "@vaporflow/core": "workspace:*"
  },
  "main": "./src/index.ts",
  "types": "./dist-ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-ts/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "12.11.1",
    "@capacitor/cli": "^6.2.0"
  }
}
