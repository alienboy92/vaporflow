{
  "name": "@vaporflow/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @vaporflow/app build && node -e \"const fs=require('fs');fs.cpSync('../../packages/app/dist','./dist',{recursive:true,force:true})\"",
    "cap:sync": "npx cap sync android",
    "android:run": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/android.ps1",
    "typecheck": "tsc --noEmit",
    "build:diagnostics": "pnpm --filter @vaporflow/app build:diagnostics && node -e \"const fs=require('fs');fs.cpSync('../../packages/app/dist','./dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@vaporflow/core": "workspace:*",
    "@capacitor-community/sqlite": "6.0.2"
  },
  "main": "./src/index.ts",
  "types": "./dist-ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-ts/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "devDependencies": {
    "better-sqlite3": "12.11.1",
    "@types/better-sqlite3": "9.6.0"
  }
}
