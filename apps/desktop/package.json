{
  "name": "@vaporflow/desktop",
  "description": "Offline-first VaporFlow retail point of sale for Windows",
  "author": "Abdullah Aaraiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "pnpm --filter @vaporflow/app build && node scripts/build-electron.js && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "build:unpacked": "pnpm --filter @vaporflow/app build && node scripts/build-electron.js && electron-builder --dir --win",
    "smoke": "node scripts/smoke.js",
    "test:contract": "node scripts/contract.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0",
    "@vaporflow/core": "workspace:*",
    "electron-builder-squirrel-windows": "26.18.0"
  },
  "build": {
    "appId": "com.vaporflow.pos",
    "productName": "VaporFlow",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      {
        "from": "../../packages/app/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  }
}
