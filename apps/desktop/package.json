{
  "name": "@bali-hub-pos/desktop",
  "description": "Offline-first Bali Hub POS retail point of sale for Windows",
  "author": "Abdullah Aaraiz",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "pnpm --filter @bali-hub-pos/app build && node scripts/build-electron.js && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "build:unpacked": "pnpm --filter @bali-hub-pos/app build && node scripts/build-electron.js && electron-builder --dir --win",
    "smoke": "node scripts/smoke.js",
    "test:contract": "node scripts/contract.js"
  },
  "devDependencies": {
    "@bali-hub-pos/core": "workspace:*",
    "@types/node": "^22.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.vaporflow.pos",
    "publish": { "provider": "github", "owner": "alienboy92", "repo": "vaporflow" },
    "productName": "Bali Hub POS",
    "extraResources": [{ "from": "../../dist-sql/setup.sql", "to": "setup.sql" }],
    "directories": {
      "output": "out"
    },
    "files": [
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      {
        "from": "../../packages/app/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "electron-updater": "6"
  }
}
