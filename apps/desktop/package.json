{
  "name": "@vaporflow/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "pnpm --filter @vaporflow/app build && node scripts/build-electron.js && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vaporflow/app": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.vaporflow.pos",
    "productName": "VaporFlow",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist-electron/**/*",
      {
        "from": "../packages/app/dist",
        "to": "renderer",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
